# SMTP postavke za email obavještenja (src/dentaland/services/notifications.py)
#
# Ove varijable su OPCIONE: bez DENTALAND_SMTP_HOST slanje se tiho preskače
# (best-effort — aplikacija radi normalno, samo ne šalje email). Postavljaju
# se ručno u terminalu prije pokretanja (npr. prije `python scripts/dev_local.py`).
#
# VAŽNO: aplikacija NE čita `.env` fajl automatski — ovaj fajl je samo referenca
# koju ručno kopiraš/popunjavaš u terminalu. Za tačne PowerShell korake vidi
# README.md, odjeljak "Email obavještenja (SMTP)".
#
# Vrijednosti ispod su PRIMJERI, ne stvarni kredencijali — ne commitovati stvarne.

DENTALAND_SMTP_HOST=smtp.gmail.com
DENTALAND_SMTP_PORT=587
DENTALAND_SMTP_USER=tvoja.adresa@gmail.com

# Gmail zahtijeva "App Password" (16 znakova, generisan na
# myaccount.google.com/apppasswords uz uključenu 2-Step Verification),
# NE običnu Gmail lozinku — obična lozinka vraća grešku
# `534 5.7.9 Application-specific password required`.
DENTALAND_SMTP_PASSWORD=

DENTALAND_SMTP_FROM=tvoja.adresa@gmail.com

# Backup cloud/sync folder (src/dentaland/backup_cli.py)
# OPCIONO: ako nije postavljeno, enkriptovani backupe idu u lokalni
# data_dir()/backups (radi odmah, ali bez off-site kopije).
# Za produkciju postavi na pravi Google Drive/Dropbox sync folder, npr.:
# DENTALAND_BACKUP_CLOUD_DIR=C:\Users\<korisnik>\Google Drive\Dentaland-backup
# DENTALAND_BACKUP_CLOUD_DIR=
